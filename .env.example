# ─── Docker Compose Environment ─────────────────────────
# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=check_it

# JWT Secret (change in production!)
SECRET_KEY=your-super-secret-key-change-me

# Anthropic Claude (primary LLM — enables AI validation & risk analysis)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# Google Gemini API (fallback LLM, optional)
GEMINI_API_KEY=

# Redis cache TTL in seconds (default: 2 hours)
# CACHE_TTL_SECONDS=7200

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:your_password@db:5432/check_it"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="check_it"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"

# JWT
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

# Hugging Face (optional)
HUGGINGFACE_API_KEY=""

# Scraper DB (unified - same as main DB)
DB_NAME="check_it"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_HOST="db"
DB_PORT="5432"
